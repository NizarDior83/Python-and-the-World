{
  "expo": {
    "name": "WorldBites",
    "slug": "worldbites",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "worldbites",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF3E0",
    "splash": {
      "backgroundColor": "#FFB627"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.worldbites.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFB627"
      },
      "package": "com.worldbites.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
